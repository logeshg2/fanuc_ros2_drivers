<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fanuc_lrmate200id4s">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fanuc_lrmate200id4s urdf file -->
    <xacro:include filename="$(find moveit_fanuc_description)/urdf/lrmate200id4s.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="fanuc_lrmate200id4s.ros2_control.xacro" />


    <xacro:fanuc_lrmate200id4s_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
